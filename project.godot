; Demo / dev project for Equipment — Lite.

config_version=5

[application]

config/name="Equipment (Lite) · Demo"
config/description="Free 4-slot equipment for Godot 4.5+."
config/features=PackedStringArray("4.5", "GL Compatibility")
run/main_scene="res://demo/equipment_demo.tscn"

[display]

window/size/viewport_width=900
window/size/viewport_height=520

[editor_plugins]

enabled=PackedStringArray("res://addons/equipment_lite/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
